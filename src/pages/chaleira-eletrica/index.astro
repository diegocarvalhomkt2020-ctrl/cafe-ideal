---
import Layout from '../../layouts/Layout.astro';
import ProdutoCard from '../../components/ProdutoCard.astro';
import dados from '../../data/produtos-chaleira.json';

const categoria = dados.categorias.find((c) => c.id === 'chaleira-eletrica');
const produtos = categoria.produtos;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Início", item: "https://cafe.dicasinteligentes.com/" },
    { "@type": "ListItem", position: 2, name: "Chaleira elétrica", item: "https://cafe.dicasinteligentes.com/chaleira-eletrica/" },
  ],
};

const faq = [
  {
    pergunta: "Preciso de chaleira bico de ganso pra fazer café coado?",
    resposta: "Não é obrigatório, mas ajuda bastante. O bico fino e longo permite despejar a água devagar e em círculos, o que controla melhor a extração do café. Com bico comum, dá pra fazer café coado, só que com menos controle sobre o resultado.",
  },
  {
    pergunta: "Vale a pena controle eletrônico de temperatura?",
    resposta: "Depende do quanto você já se importa com a temperatura ideal da água (entre 90-96°C pra maioria dos métodos). Se você já mede com termômetro separado, um modelo com termômetro integrado (mais barato) já resolve. Controle automático só compensa se você quer o processo mais simplificado.",
  },
  {
    pergunta: "Chaleira elétrica gasta muito mais energia que fogão?",
    resposta: "Geralmente é mais eficiente, não menos: a resistência fica em contato direto com a água, sem perder calor pro ambiente como acontece numa chaleira no fogão. O tempo pra ferver também costuma ser mais rápido.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((item) => ({
    "@type": "Question",
    name: item.pergunta,
    acceptedAnswer: { "@type": "Answer", text: item.resposta },
  })),
};
---
<Layout
  title="Chaleira elétrica para café: qual escolher"
  description="Chaleiras elétricas pesquisadas na Amazon, com preço, nota e o defeito real de cada uma, comparando bico de ganso e modelo comum, pra escolher sem chute."
  image="/images/produtos/chaleira-bico-ganso-1l-termometro-integrado.png"
>
  <p><a href="/">← Início</a></p>
  <h1>Chaleira elétrica para café: qual escolher</h1>
  <p class="atualizado">Todos os produtos abaixo foram pesquisados na Amazon, com preço, nota e avaliações reais.</p>

  <p>
    Chaleira errada pro café coado é bico grosso demais (despeja rápido e
    desregula a extração) ou sem controle de temperatura (água fervendo
    demais queima o café). Nessa lista comparamos modelo bico de ganso
    (pra técnica) e modelo comum (pra uso geral).
  </p>

  <section class="como-escolhemos">
    <h2>Como escolhemos</h2>
    <p>
      Nenhum produto entra nessa lista sem um defeito real declarado (bloco
      "Vale saber" em cada card), pesquisado na ficha técnica e nas
      características reais do produto. Preço sempre em faixa, nunca fixo.
    </p>
  </section>

  <section class="comparativo">
    <h2>Comparativo rápido</h2>
    <div class="tabela-wrap">
      <table>
        <thead>
          <tr>
            <th>Produto</th>
            <th>Preço</th>
            <th>Selo</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          {produtos.map((produto) => (
            <tr>
              <td data-label="Produto">{produto.nome}</td>
              <td data-label="Preço">{produto.precoMin === produto.precoMax ? `R$ ${produto.precoMin}` : `R$ ${produto.precoMin} a R$ ${produto.precoMax}`}</td>
              <td data-label="Selo">{produto.selo || "—"}</td>
              <td data-label="">
                <a class="botao-tabela" href={produto.linkAmazon} rel="sponsored nofollow">Ver preço</a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="honestidade">
    <h2>Onde vale gastar mais, onde não faz diferença</h2>
    <p>
      Se você não faz café coado com técnica, a Cadence Infusion (~R$142)
      resolve bem e é a mais testada do mercado. Se faz café coado e quer
      controle de despejo, o bico de ganso com termômetro (~R$120) já
      entrega o essencial por bem menos que a Cocinare (~R$649). Essa só
      vale a diferença de preço se controle automático de temperatura for
      prioridade real no seu método. A mais barata (~R$50) é só pra quem
      quer água quente rápido, sem se importar com técnica.
    </p>
  </section>

  <section id={categoria.id} class="categoria">
    <h2>{categoria.nome}</h2>
    <p>{categoria.descricao}</p>
    {produtos.map((produto) => <ProdutoCard produto={produto} />)}
  </section>

  <p class="cluster-link">
    Veja também:
    <a href="/chaleira-eletrica/erros-comuns/">os erros mais comuns escolhendo chaleira →</a>
    ·
    <a href="/chaleira-eletrica/por-orcamento/">as mesmas chaleiras por orçamento →</a>
    ·
    <a href="/chaleira-eletrica/comparativo-top3/">comparativo Top 3 lado a lado →</a>
    ·
    <a href="/cafeteira/">cafeteira elétrica: qual escolher →</a>
    ·
    <a href="/moedor-de-cafe/">moedor de café: qual escolher →</a>
    ·
    <a href="/copo-termico/">copo térmico para café: qual escolher →</a>
  </p>

  <section class="faq">
    <h2>Perguntas frequentes</h2>
    {faq.map((item) => (
      <div class="faq-item">
        <h3>{item.pergunta}</h3>
        <p>{item.resposta}</p>
      </div>
    ))}
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <style>
    .atualizado { color: var(--cor-texto-suave); font-size: 0.9rem; }
    .cluster-link { font-weight: 600; margin: 2.5rem 0 0; line-height: 2; }
    .como-escolhemos {
      background: var(--cor-superficie);
      border: 1px solid var(--cor-borda);
      border-radius: 10px;
      padding: 1rem 1.25rem;
      margin: 1.5rem 0;
    }
    .como-escolhemos h2 { font-size: 1rem; margin: 0 0 0.4rem; }
    .como-escolhemos p { margin: 0; font-size: 0.9rem; color: var(--cor-texto-suave); }
    .comparativo { margin: 1.5rem 0 2.5rem; }
    .tabela-wrap { overflow-x: auto; }
    table { width: 100%; border-collapse: collapse; table-layout: fixed; font-size: 0.85rem; }
    th, td {
      text-align: left;
      padding: 0.6rem 0.5rem;
      border-bottom: 1px solid var(--cor-borda);
      white-space: normal;
      overflow-wrap: break-word;
    }
    th { color: var(--cor-texto-suave); font-weight: 600; font-size: 0.75rem; text-transform: uppercase; }
    th:nth-child(1), td:nth-child(1) { width: 40%; }
    th:nth-child(2), td:nth-child(2) { width: 22%; }
    th:nth-child(3), td:nth-child(3) { width: 20%; }
    th:nth-child(4), td:nth-child(4) { width: 18%; }
    .botao-tabela {
      display: inline-block;
      background: var(--cor-acento);
      color: #fff;
      text-decoration: none;
      padding: 0.3rem 0.55rem;
      border-radius: 999px;
      font-size: 0.76rem;
      white-space: nowrap;
    }
    .categoria { margin-bottom: 2.5rem; padding-top: 0.5rem; }
    .honestidade {
      margin: 2.5rem 0;
      padding: 1.5rem 1.75rem;
      background: var(--cor-superficie);
      border: 1px solid var(--cor-borda);
      border-left: 4px solid var(--cor-vale-saber);
      border-radius: 10px;
    }
    .honestidade h2 { margin: 0 0 0.75rem; font-size: 1.15rem; }
    .honestidade p { margin: 0; color: var(--cor-texto-suave); }
    .faq {
      margin-top: 2.5rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--cor-borda);
    }
    .faq-item { margin-bottom: 1.25rem; }
    .faq-item h3 { font-size: 1rem; margin: 0 0 0.35rem; }
    .faq-item p { margin: 0; color: var(--cor-texto-suave); }

    @media (max-width: 640px) {
      table, thead, tbody, th, td, tr { display: block; }
      thead { position: absolute; left: -9999px; }
      tr {
        border: 1px solid var(--cor-borda);
        border-radius: 10px;
        padding: 0.75rem 0.9rem;
        margin-bottom: 0.75rem;
        background: var(--cor-superficie);
      }
      td {
        border: none;
        padding: 0.35rem 0;
        white-space: normal;
        width: auto !important;
      }
      td[data-label="Preço"] { white-space: nowrap; }
      td[data-label]:not([data-label=""])::before {
        content: attr(data-label);
        display: block;
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        color: var(--cor-texto-suave);
        margin-bottom: 0.1rem;
      }
      td:last-child { padding-top: 0.6rem; }
    }
  </style>
</Layout>
