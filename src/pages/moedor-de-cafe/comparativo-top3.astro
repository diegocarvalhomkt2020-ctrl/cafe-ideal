---
import Layout from '../../layouts/Layout.astro';
import dados from '../../data/produtos.json';

const categoria = dados.categorias.find((c) => c.id === 'moedor-de-cafe');
const top3 = [...categoria.produtos].sort((a, b) => b.avaliacoes - a.avaliacoes).slice(0, 3);

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Início", item: "https://cafe.dicasinteligentes.com/" },
    { "@type": "ListItem", position: 2, name: "Moedor de café", item: "https://cafe.dicasinteligentes.com/moedor-de-cafe/" },
    { "@type": "ListItem", position: 3, name: "Comparativo Top 3", item: "https://cafe.dicasinteligentes.com/moedor-de-cafe/comparativo-top3/" },
  ],
};
---
<Layout
  title="Comparativo Top 3: moedor de café"
  description="Os 3 moedores de café mais avaliados entre os que pesquisamos, lado a lado — preço, nota e o que vale saber antes de decidir qual comprar."
>
  <p><a href="/moedor-de-cafe/">← Moedor de café elétrico</a></p>
  <h1>Comparativo Top 3: moedor de café</h1>
  <p class="atualizado">Atualizado em agosto de 2026</p>

  <p>
    Os 3 moedores com mais avaliações entre os que pesquisamos, lado a
    lado: preço, nota, maior ponto forte e o que vale saber antes de
    comprar.
  </p>

  <div class="tabela-wrap">
    <table>
      <thead>
        <tr>
          <th scope="col"><span class="sr-only">Critério</span></th>
          {top3.map((p) => <th scope="col">{p.selo}</th>)}
        </tr>
      </thead>
      <tbody>
        <tr>
          <th scope="row">Produto</th>
          {top3.map((p) => <td><strong>{p.nome}</strong></td>)}
        </tr>
        <tr>
          <th scope="row">Preço</th>
          {top3.map((p) => <td>R$ {p.precoMin} a R$ {p.precoMax}</td>)}
        </tr>
        <tr>
          <th scope="row">Nota</th>
          {top3.map((p) => <td>★ {p.nota} ({p.avaliacoes} avaliações)</td>)}
        </tr>
        <tr>
          <th scope="row">Maior ponto forte</th>
          {top3.map((p) => <td>{p.pros[0]}</td>)}
        </tr>
        <tr>
          <th scope="row">Vale saber</th>
          {top3.map((p) => <td class="linha-contra">{p.contra}</td>)}
        </tr>
        <tr>
          <th scope="row"><span class="sr-only">Ação</span></th>
          {top3.map((p) => (
            <td>
              <a class="botao-tabela" href={p.linkAmazon} rel="sponsored nofollow">Ver preço</a>
            </td>
          ))}
        </tr>
      </tbody>
    </table>
  </div>

  <p class="cta-final">
    Quer ver as outras opções também?
    <a href="/moedor-de-cafe/">Volte pro guia completo →</a>
  </p>

  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <style>
    .sr-only {
      position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
      overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0;
    }
    .atualizado { color: var(--cor-texto-suave); font-size: 0.9rem; }
    .tabela-wrap { overflow-x: auto; margin: 1.5rem 0; }
    table { width: 100%; border-collapse: collapse; font-size: 0.85rem; min-width: 560px; }
    th, td {
      text-align: left;
      padding: 0.65rem 0.6rem;
      border-bottom: 1px solid var(--cor-borda);
      vertical-align: top;
    }
    thead th {
      color: var(--cor-acento);
      font-weight: 700;
      font-size: 0.78rem;
      text-transform: uppercase;
      white-space: nowrap;
    }
    tbody th {
      font-weight: 600;
      color: var(--cor-texto-suave);
      font-size: 0.78rem;
      text-transform: uppercase;
      white-space: nowrap;
      text-align: left;
    }
    .linha-contra { color: var(--cor-vale-saber); font-size: 0.82rem; }
    .botao-tabela {
      display: inline-block;
      background: var(--cor-acento);
      color: #fff;
      text-decoration: none;
      padding: 0.35rem 0.7rem;
      border-radius: 999px;
      font-size: 0.78rem;
      white-space: nowrap;
    }
    .cta-final {
      margin-top: 2rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--cor-borda);
      font-weight: 600;
    }
  </style>
</Layout>
