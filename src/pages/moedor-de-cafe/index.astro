---
import Layout from '../../layouts/Layout.astro';
import ProdutoCard from '../../components/ProdutoCard.astro';
import dados from '../../data/produtos.json';

const categoria = dados.categorias.find((c) => c.id === 'moedor-de-cafe');
const produtos = categoria.produtos;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Início", item: "https://cafe.dicasinteligentes.com/" },
    { "@type": "ListItem", position: 2, name: "Moedor de café", item: "https://cafe.dicasinteligentes.com/moedor-de-cafe/" },
  ],
};

const faq = [
  {
    pergunta: "Moedor de lâmina ou de rebarba (ajustável), qual escolher?",
    resposta: "Lâmina (Cadence, Oster, Philco) é mais barato e resolve bem café coado ou de filtro. Rebarba ajustável (Hamilton Beach) custa mais, mas dá controle real sobre o ponto da moagem. Vale a diferença se você usa prensa francesa, espresso ou é exigente com consistência.",
  },
  {
    pergunta: "Vale a pena moer o próprio grão em vez de comprar pó pronto?",
    resposta: "Sim, pro sabor: café perde aroma rápido depois de moído, então moer na hora rende uma xícara bem mais encorpada. A troca é limpeza extra. Nenhum moedor da lista lava tudo com facilidade, então prepare-se pra usar escova ou pano com frequência.",
  },
  {
    pergunta: "Moedor barato aguenta uso diário?",
    resposta: "Os de marca conhecida (Cadence, Oster, Philco) têm milhares de avaliações confirmando uso prolongado. Já o mais barato da lista tem só 25 avaliações e um relato real de superaquecimento no primeiro uso. Funciona, mas é mais arriscado pra quem mói café todo dia.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((item) => ({
    "@type": "Question",
    name: item.pergunta,
    acceptedAnswer: { "@type": "Answer", text: item.resposta },
  })),
};
---
<Layout
  title="Moedor de café elétrico: qual escolher"
  description="Moedores de café elétricos pesquisados e comparados na Amazon, do mais barato ao ajustável, com preço, nota e o defeito real de cada um."
  image="/images/produtos/cadence-di-grano-moedor-cafe.png"
>
  <p><a href="/">← Início</a></p>
  <h1>Moedor de café elétrico: qual escolher</h1>
  <p class="atualizado">Todos os produtos abaixo foram pesquisados na Amazon (lista de mais vendidos), com preço, nota e avaliações reais. Fotos ainda em produção.</p>

  <p>
    Café moído na hora rende mais sabor do que pó de pacote, mas moedor
    errado significa pó irregular, limpeza chata ou moagem que não serve
    pro seu método de preparo. Os produtos abaixo estão em ordem de preço:
    do mais simples pra testar, até o ajustável pra quem já sabe o que quer.
  </p>

  <section class="como-escolhemos">
    <h2>Como escolhemos</h2>
    <p>
      Nenhum moedor entra nessa lista sem um defeito real declarado (bloco
      "Vale saber" em cada card), pesquisado em avaliação de comprador,
      nunca inventado. Preço sempre em faixa, nunca fixo.
    </p>
  </section>

  <section class="comparativo">
    <h2>Comparativo rápido</h2>
    <div class="tabela-wrap">
      <table>
        <thead>
          <tr>
            <th scope="col">Produto</th>
            <th scope="col">Preço</th>
            <th scope="col">Selo</th>
            <th scope="col"><span class="sr-only">Ação</span></th>
          </tr>
        </thead>
        <tbody>
          {produtos.map((produto) => (
            <tr>
              <td data-label="Produto">{produto.nome}</td>
              <td data-label="Preço">R$ {produto.precoMin} a R$ {produto.precoMax}</td>
              <td data-label="Selo">{produto.selo || "—"}</td>
              <td data-label="">
                <a class="botao-tabela" href={produto.linkAmazon} rel="sponsored nofollow">Ver preço</a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="honestidade">
    <h2>Onde vale gastar mais, onde não faz diferença</h2>
    <p>
      A diferença entre o mais barato (~R$40) e o mais completo (~R$315) não
      é sobre "moer café", todos moem. É sobre controle e durabilidade: o
      ajustável (Hamilton Beach) dá níveis reais de moagem e câmara
      removível pra lavar, o que importa pra quem usa prensa francesa ou
      espresso. Pra café coado do dia a dia, qualquer um dos moedores de
      lâmina já resolve. O barato só é mais arriscado em uso muito
      frequente.
    </p>
  </section>

  <section id="moedor-de-cafe" class="categoria">
    <h2>{categoria.nome}</h2>
    <p>{categoria.descricao}</p>
    {produtos.map((produto) => <ProdutoCard produto={produto} />)}
  </section>

  <p class="cluster-link">
    Veja também:
    <a href="/moedor-de-cafe/erros-comuns/">os erros mais comuns escolhendo moedor →</a>
    ·
    <a href="/moedor-de-cafe/por-orcamento/">os mesmos moedores por orçamento →</a>
    ·
    <a href="/moedor-de-cafe/comparativo-top3/">comparativo Top 3 lado a lado →</a>
  </p>

  <section class="faq">
    <h2>Perguntas frequentes</h2>
    {faq.map((item) => (
      <div class="faq-item">
        <h3>{item.pergunta}</h3>
        <p>{item.resposta}</p>
      </div>
    ))}
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <style>
    .sr-only {
      position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
      overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0;
    }
    .atualizado { color: var(--cor-texto-suave); font-size: 0.9rem; }
    .cluster-link { font-weight: 600; margin: 2.5rem 0 0; line-height: 2; }
    .como-escolhemos {
      background: var(--cor-superficie);
      border: 1px solid var(--cor-borda);
      border-radius: 10px;
      padding: 1rem 1.25rem;
      margin: 1.5rem 0;
    }
    .como-escolhemos h2 { font-size: 1rem; margin: 0 0 0.4rem; }
    .como-escolhemos p { margin: 0; font-size: 0.9rem; color: var(--cor-texto-suave); }
    .comparativo { margin: 1.5rem 0 2.5rem; }
    .tabela-wrap { overflow-x: auto; }
    table { width: 100%; border-collapse: collapse; table-layout: fixed; font-size: 0.85rem; }
    th, td {
      text-align: left;
      padding: 0.6rem 0.5rem;
      border-bottom: 1px solid var(--cor-borda);
      white-space: normal;
      overflow-wrap: break-word;
    }
    th { color: var(--cor-texto-suave); font-weight: 600; font-size: 0.75rem; text-transform: uppercase; }
    th:nth-child(1), td:nth-child(1) { width: 40%; }
    th:nth-child(2), td:nth-child(2) { width: 22%; }
    th:nth-child(3), td:nth-child(3) { width: 20%; }
    th:nth-child(4), td:nth-child(4) { width: 18%; }
    .botao-tabela {
      display: inline-block;
      background: var(--cor-acento);
      color: #fff;
      text-decoration: none;
      padding: 0.3rem 0.55rem;
      border-radius: 999px;
      font-size: 0.76rem;
      white-space: nowrap;
    }
    .categoria { margin-bottom: 2.5rem; padding-top: 0.5rem; }
    .honestidade {
      margin: 2.5rem 0;
      padding: 1.5rem 1.75rem;
      background: var(--cor-superficie);
      border: 1px solid var(--cor-borda);
      border-left: 4px solid var(--cor-vale-saber);
      border-radius: 10px;
    }
    .honestidade h2 { margin: 0 0 0.75rem; font-size: 1.15rem; }
    .honestidade p { margin: 0; color: var(--cor-texto-suave); }
    .faq {
      margin-top: 2.5rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--cor-borda);
    }
    .faq-item { margin-bottom: 1.25rem; }
    .faq-item h3 { font-size: 1rem; margin: 0 0 0.35rem; }
    .faq-item p { margin: 0; color: var(--cor-texto-suave); }

    @media (max-width: 640px) {
      table, thead, tbody, th, td, tr { display: block; }
      thead { position: absolute; left: -9999px; }
      tr {
        border: 1px solid var(--cor-borda);
        border-radius: 10px;
        padding: 0.75rem 0.9rem;
        margin-bottom: 0.75rem;
        background: var(--cor-superficie);
      }
      td {
        border: none;
        padding: 0.35rem 0;
        white-space: normal;
        width: auto !important;
      }
      td[data-label="Preço"] { white-space: nowrap; }
      td[data-label]:not([data-label=""])::before {
        content: attr(data-label);
        display: block;
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        color: var(--cor-texto-suave);
        margin-bottom: 0.1rem;
      }
      td:last-child { padding-top: 0.6rem; }
    }
  </style>
</Layout>
