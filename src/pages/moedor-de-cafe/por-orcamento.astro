---
import Layout from '../../layouts/Layout.astro';
import ProdutoCard from '../../components/ProdutoCard.astro';
import dados from '../../data/produtos.json';

const categoria = dados.categorias.find((c) => c.id === 'moedor-de-cafe');
const produtos = [...categoria.produtos].sort((a, b) => a.precoMin - b.precoMin);

const faixas = [
  { titulo: "Até R$100", min: 0, max: 100 },
  { titulo: "R$100 a R$200", min: 100, max: 200 },
  { titulo: "Acima de R$200", min: 200, max: Infinity },
];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Início", item: "https://cafe.dicasinteligentes.com/" },
    { "@type": "ListItem", position: 2, name: "Moedor de café", item: "https://cafe.dicasinteligentes.com/moedor-de-cafe/" },
    { "@type": "ListItem", position: 3, name: "Por orçamento", item: "https://cafe.dicasinteligentes.com/moedor-de-cafe/por-orcamento/" },
  ],
};
---
<Layout
  title="Moedor de café elétrico por orçamento"
  description="Os mesmos moedores de café elétricos pesquisados na Amazon, separados por faixa de preço, do mais barato ao mais completo, com nota e contra real de cada um."
>
  <p><a href="/moedor-de-cafe/">← Moedor de café elétrico</a></p>
  <h1>Moedor de café por orçamento</h1>
  <p>Os mesmos produtos do guia principal, separados por faixa de preço.</p>

  {faixas.map((faixa) => {
    const produtosFaixa = produtos.filter((p) => p.precoMin >= faixa.min && p.precoMin < faixa.max);
    return produtosFaixa.length > 0 && (
      <section class="faixa">
        <h2>{faixa.titulo}</h2>
        {produtosFaixa.map((produto) => <ProdutoCard produto={produto} />)}
      </section>
    );
  })}

  <p class="cta-final">
    Quer ver o comparativo completo?
    <a href="/moedor-de-cafe/">Volte pro guia completo →</a>
  </p>

  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <style>
    .faixa { margin: 2rem 0; }
    .faixa h2 { font-size: 1.1rem; margin: 0 0 1rem; color: var(--cor-acento); }
    .cta-final {
      margin-top: 2rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--cor-borda);
      font-weight: 600;
    }
  </style>
</Layout>
