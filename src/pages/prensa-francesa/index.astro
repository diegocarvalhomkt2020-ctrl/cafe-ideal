---
import Layout from '../../layouts/Layout.astro';
import ProdutoCard from '../../components/ProdutoCard.astro';
import dados from '../../data/produtos-prensa-francesa.json';

const categoria = dados.categorias.find((c) => c.id === 'prensa-francesa');
const produtos = categoria.produtos;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Início", item: "https://cafe.dicasinteligentes.com/" },
    { "@type": "ListItem", position: 2, name: "Prensa francesa", item: "https://cafe.dicasinteligentes.com/prensa-francesa/" },
  ],
};

const faq = [
  {
    pergunta: "Prensa francesa deixa borra na xícara?",
    resposta: "Um pouco, sim — é característica do método, não defeito. O filtro de metal deixa passar mais óleo e partícula fina que um filtro de papel. Quem gosta de café mais encorpado costuma preferir assim; quem não gosta de borra prefere café coado com filtro de papel.",
  },
  {
    pergunta: "Vidro trinca fácil na prensa francesa?",
    resposta: "Depende da qualidade do vidro. Marca popular costuma usar vidro mais fino, mais sensível a choque térmico (água fervendo direto num vidro frio, por exemplo). Marca premium geralmente usa vidro mais resistente. De qualquer forma, evite mudança brusca de temperatura em qualquer uma.",
  },
  {
    pergunta: "350ml ou 600ml, qual escolher?",
    resposta: "350ml rende cerca de 2 xícaras, bom pra uso individual. 600ml rende o dobro, melhor se você prepara café pra mais gente ou quer servir mais de uma vez sem repetir o processo.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((item) => ({
    "@type": "Question",
    name: item.pergunta,
    acceptedAnswer: { "@type": "Answer", text: item.resposta },
  })),
};
---
<Layout
  title="Prensa francesa para café: qual escolher"
  description="Prensas francesas pesquisadas na Amazon, com preço, nota e o defeito real de cada uma, comparando marca popular e marca premium, pra escolher sem chute."
  image="/images/produtos/bialetti-french-press-preziosa-350ml.png"
>
  <p><a href="/">← Início</a></p>
  <h1>Prensa francesa para café: qual escolher</h1>
  <p class="atualizado">Todos os produtos abaixo foram pesquisados na Amazon, com preço, nota e avaliações reais.</p>

  <p>
    Prensa francesa errada é vidro fino que trinca no primeiro choque
    térmico ou êmbolo que não filtra direito, deixando borra em excesso na
    xícara. Nessa lista comparamos marca popular (mais barata, nota menor)
    e marca premium (mais cara, nota maior).
  </p>

  <section class="como-escolhemos">
    <h2>Como escolhemos</h2>
    <p>
      Nenhum produto entra nessa lista sem um defeito real declarado (bloco
      "Vale saber" em cada card), pesquisado na ficha técnica e nas
      características reais do produto. Preço sempre em faixa, nunca fixo.
    </p>
  </section>

  <section class="comparativo">
    <h2>Comparativo rápido</h2>
    <div class="tabela-wrap">
      <table>
        <thead>
          <tr>
            <th>Produto</th>
            <th>Preço</th>
            <th>Selo</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          {produtos.map((produto) => (
            <tr>
              <td data-label="Produto">{produto.nome}</td>
              <td data-label="Preço">{produto.precoMin === produto.precoMax ? `R$ ${produto.precoMin}` : `R$ ${produto.precoMin} a R$ ${produto.precoMax}`}</td>
              <td data-label="Selo">{produto.selo || "—"}</td>
              <td data-label="">
                <a class="botao-tabela" href={produto.linkAmazon} rel="sponsored nofollow">Ver preço</a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="honestidade">
    <h2>Onde vale gastar mais, onde não faz diferença</h2>
    <p>
      A Mimo Style (~R$24-27) tem o maior volume de avaliações de todas as
      opções pesquisadas neste site (mais de 10 mil), então não é um
      "aposta arriscada" — é só uma nota um pouco menor (4,4) que a Bialetti
      (4,7-4,8). Se orçamento for a prioridade, ela resolve bem. A Bialetti
      Preziosa (~R$251-325) só compensa a diferença de mais de 10x no preço
      se durabilidade a longo prazo e marca de referência pesarem muito na
      decisão.
    </p>
  </section>

  <section id={categoria.id} class="categoria">
    <h2>{categoria.nome}</h2>
    <p>{categoria.descricao}</p>
    {produtos.map((produto) => <ProdutoCard produto={produto} />)}
  </section>

  <p class="cluster-link">
    Veja também:
    <a href="/prensa-francesa/erros-comuns/">os erros mais comuns usando prensa francesa →</a>
    ·
    <a href="/prensa-francesa/por-orcamento/">as mesmas prensas por orçamento →</a>
    ·
    <a href="/prensa-francesa/comparativo-top3/">comparativo Top 3 lado a lado →</a>
    ·
    <a href="/cafeteira/">cafeteira elétrica: qual escolher →</a>
    ·
    <a href="/chaleira-eletrica/">chaleira elétrica: qual escolher →</a>
    ·
    <a href="/moedor-de-cafe/">moedor de café: qual escolher →</a>
  </p>

  <section class="faq">
    <h2>Perguntas frequentes</h2>
    {faq.map((item) => (
      <div class="faq-item">
        <h3>{item.pergunta}</h3>
        <p>{item.resposta}</p>
      </div>
    ))}
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <style>
    .atualizado { color: var(--cor-texto-suave); font-size: 0.9rem; }
    .cluster-link { font-weight: 600; margin: 2.5rem 0 0; line-height: 2; }
    .como-escolhemos {
      background: var(--cor-superficie);
      border: 1px solid var(--cor-borda);
      border-radius: 10px;
      padding: 1rem 1.25rem;
      margin: 1.5rem 0;
    }
    .como-escolhemos h2 { font-size: 1rem; margin: 0 0 0.4rem; }
    .como-escolhemos p { margin: 0; font-size: 0.9rem; color: var(--cor-texto-suave); }
    .comparativo { margin: 1.5rem 0 2.5rem; }
    .tabela-wrap { overflow-x: auto; }
    table { width: 100%; border-collapse: collapse; table-layout: fixed; font-size: 0.85rem; }
    th, td {
      text-align: left;
      padding: 0.6rem 0.5rem;
      border-bottom: 1px solid var(--cor-borda);
      white-space: normal;
      overflow-wrap: break-word;
    }
    th { color: var(--cor-texto-suave); font-weight: 600; font-size: 0.75rem; text-transform: uppercase; }
    th:nth-child(1), td:nth-child(1) { width: 40%; }
    th:nth-child(2), td:nth-child(2) { width: 22%; }
    th:nth-child(3), td:nth-child(3) { width: 20%; }
    th:nth-child(4), td:nth-child(4) { width: 18%; }
    .botao-tabela {
      display: inline-block;
      background: var(--cor-acento);
      color: #fff;
      text-decoration: none;
      padding: 0.3rem 0.55rem;
      border-radius: 999px;
      font-size: 0.76rem;
      white-space: nowrap;
    }
    .categoria { margin-bottom: 2.5rem; padding-top: 0.5rem; }
    .honestidade {
      margin: 2.5rem 0;
      padding: 1.5rem 1.75rem;
      background: var(--cor-superficie);
      border: 1px solid var(--cor-borda);
      border-left: 4px solid var(--cor-vale-saber);
      border-radius: 10px;
    }
    .honestidade h2 { margin: 0 0 0.75rem; font-size: 1.15rem; }
    .honestidade p { margin: 0; color: var(--cor-texto-suave); }
    .faq {
      margin-top: 2.5rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--cor-borda);
    }
    .faq-item { margin-bottom: 1.25rem; }
    .faq-item h3 { font-size: 1rem; margin: 0 0 0.35rem; }
    .faq-item p { margin: 0; color: var(--cor-texto-suave); }

    @media (max-width: 640px) {
      table, thead, tbody, th, td, tr { display: block; }
      thead { position: absolute; left: -9999px; }
      tr {
        border: 1px solid var(--cor-borda);
        border-radius: 10px;
        padding: 0.75rem 0.9rem;
        margin-bottom: 0.75rem;
        background: var(--cor-superficie);
      }
      td {
        border: none;
        padding: 0.35rem 0;
        white-space: normal;
        width: auto !important;
      }
      td[data-label="Preço"] { white-space: nowrap; }
      td[data-label]:not([data-label=""])::before {
        content: attr(data-label);
        display: block;
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        color: var(--cor-texto-suave);
        margin-bottom: 0.1rem;
      }
      td:last-child { padding-top: 0.6rem; }
    }
  </style>
</Layout>
