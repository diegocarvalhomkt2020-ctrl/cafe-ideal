---
import Layout from '../../layouts/Layout.astro';
import ProdutoCard from '../../components/ProdutoCard.astro';
import dados from '../../data/produtos-prensa-francesa.json';

const categoria = dados.categorias.find((c) => c.id === 'prensa-francesa');
const produtos = [...categoria.produtos].sort((a, b) => a.precoMin - b.precoMin);

const faixas = [
  { titulo: "Até R$50", min: 0, max: 50 },
  { titulo: "R$50 a R$200", min: 50, max: 200 },
  { titulo: "Acima de R$200", min: 200, max: Infinity },
];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Início", item: "https://cafe.dicasinteligentes.com/" },
    { "@type": "ListItem", position: 2, name: "Prensa francesa", item: "https://cafe.dicasinteligentes.com/prensa-francesa/" },
    { "@type": "ListItem", position: 3, name: "Por orçamento", item: "https://cafe.dicasinteligentes.com/prensa-francesa/por-orcamento/" },
  ],
};
---
<Layout
  title="Prensa francesa por orçamento"
  description="As mesmas prensas francesas separadas por faixa de preço, da mais barata à mais premium."
>
  <p><a href="/prensa-francesa/">← Prensa francesa</a></p>
  <h1>Prensa francesa por orçamento</h1>
  <p>Os mesmos produtos do guia principal, separados por faixa de preço.</p>

  <section class="raciocinio">
    <h2>O que muda de verdade entre as faixas</h2>
    <p>
      Até R$50, as duas Mimo Style (350ml e 600ml) são disparadas as mais
      vendidas, mas as duas compartilham o mesmo trade-off: nota mais
      baixa que as opções Bialetti, e o vidro de marca popular costuma ser
      menos resistente a choque térmico que o de marca premium. Na faixa
      de R$50 a R$200 está a Bialetti Smart, um meio-termo, mais cara que
      a Mimo Style mas com menos avaliações que a linha Preziosa da
      própria Bialetti. Acima de R$200, a Preziosa é a mais cara da lista,
      mais de 10x o preço da Mimo Style, e só compensa se durabilidade e
      marca de referência forem prioridade real.
    </p>
  </section>

  {faixas.map((faixa) => {
    const produtosFaixa = produtos.filter((p) => p.precoMin >= faixa.min && p.precoMin < faixa.max);
    return produtosFaixa.length > 0 && (
      <section class="faixa">
        <h2>{faixa.titulo}</h2>
        {produtosFaixa.map((produto) => <ProdutoCard produto={produto} />)}
      </section>
    );
  })}

  <p class="cta-final">
    Quer ver o comparativo completo?
    <a href="/prensa-francesa/">Volte pro guia completo →</a>
  </p>

  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <style>
    .faixa { margin: 2rem 0; }
    .faixa h2 { font-size: 1.1rem; margin: 0 0 1rem; color: var(--cor-acento); }
    .cta-final {
      margin-top: 2rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--cor-borda);
      font-weight: 600;
    }
  </style>
</Layout>
