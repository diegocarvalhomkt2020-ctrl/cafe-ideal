---
import Layout from '../../layouts/Layout.astro';
import ProdutoCard from '../../components/ProdutoCard.astro';
import dados from '../../data/produtos-copo-termico.json';

const categoria = dados.categorias.find((c) => c.id === 'copo-termico');
const produtos = categoria.produtos;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Início", item: "https://cafe.dicasinteligentes.com/" },
    { "@type": "ListItem", position: 2, name: "Copo térmico", item: "https://cafe.dicasinteligentes.com/copo-termico/" },
  ],
};

const faq = [
  {
    pergunta: "Copo térmico realmente mantém o café quente por horas?",
    resposta: "Mantém, mas não pelo mesmo tempo que uma garrafa térmica de verdade. O segredo é a parede dupla a vácuo: sem ela, é só um copo de inox comum, que esfria quase tão rápido quanto um copo qualquer. Os 3 produtos desta lista têm parede dupla de verdade.",
  },
  {
    pergunta: "Copo grande (500-600ml) ou xícara pequena (160ml), qual escolher?",
    resposta: "Depende do uso. Se é pra levar café na rua ou no carro, o copo de 500-600ml compensa mais, rende mais líquido e tem tampa anti-vazamento. Se é pra tomar expresso em casa, a xícara pequena de 160ml é mais elegante e não sobra café esfriando depois que você já bebeu o que queria.",
  },
  {
    pergunta: "Vale a pena pagar mais caro numa marca conhecida?",
    resposta: "Só se durabilidade a longo prazo pesar mais que economia agora. O copo mais barato desta lista (genérico, R$26-47) já tem quase 600 avaliações reais e nota 4,3, mas tem menos histórico de marca que o WOLFF. Pra uso ocasional, o genérico resolve. Pra usar todo dia por anos, marca estabelecida costuma compensar.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((item) => ({
    "@type": "Question",
    name: item.pergunta,
    acceptedAnswer: { "@type": "Answer", text: item.resposta },
  })),
};
---
<Layout
  title="Copo térmico para café: qual escolher"
  description="Copos e canecas térmicas pra café pesquisados na Amazon, com preço, nota e o defeito real de cada um, pra escolher sem chute."
  image="/images/produtos/copo-termico-wolff-600ml-cafe.jpg"
>
  <p><a href="/">← Início</a></p>
  <h1>Copo térmico para café: qual escolher</h1>
  <p class="atualizado">Todos os produtos abaixo foram pesquisados na Amazon, com preço, nota e avaliações reais.</p>

  <p>
    Café esfriando antes de terminar é o problema mais comum de quem
    trabalha ou viaja com a bebida. Um copo térmico de verdade (parede
    dupla a vácuo) resolve isso, mas nem todo "copo térmico" anunciado
    realmente tem essa tecnologia. Os produtos abaixo estão em ordem de
    preço, dos três com parede dupla comprovada.
  </p>

  <section class="como-escolhemos">
    <h2>Como escolhemos</h2>
    <p>
      Nenhum produto entra nessa lista sem um defeito real declarado (bloco
      "Vale saber" em cada card), pesquisado na ficha técnica e nas
      características reais do produto. Preço sempre em faixa, nunca fixo.
    </p>
  </section>

  <section class="comparativo">
    <h2>Comparativo rápido</h2>
    <div class="tabela-wrap">
      <table>
        <thead>
          <tr>
            <th>Produto</th>
            <th>Preço</th>
            <th>Selo</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          {produtos.map((produto) => (
            <tr>
              <td data-label="Produto">{produto.nome}</td>
              <td data-label="Preço">{produto.precoMin === produto.precoMax ? `R$ ${produto.precoMin}` : `R$ ${produto.precoMin} a R$ ${produto.precoMax}`}</td>
              <td data-label="Selo">{produto.selo || "—"}</td>
              <td data-label="">
                <a class="botao-tabela" href={produto.linkAmazon} rel="sponsored nofollow">Ver preço</a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="honestidade">
    <h2>Onde vale gastar mais, onde não faz diferença</h2>
    <p>
      O copo genérico de R$26-47 e o WOLFF de R$49-64 têm a mesma tecnologia
      (parede dupla, tampa anti-vazamento): a diferença de preço é
      sobretudo confiança de marca e histórico de avaliações (588 contra
      quase 1.800). Se você só quer testar se copo térmico faz diferença no
      seu dia, o genérico já resolve. A xícara de 160ml não compete com os
      outros dois: é pra outro uso (mesa, expresso em casa), não pra levar
      na rua, então não faz sentido comparar preço entre ela e os copos
      grandes.
    </p>
  </section>

  <section id={categoria.id} class="categoria">
    <h2>{categoria.nome}</h2>
    <p>{categoria.descricao}</p>
    {produtos.map((produto) => <ProdutoCard produto={produto} />)}
  </section>

  <p class="cluster-link">
    Veja também:
    <a href="/cafeteira/">cafeteira elétrica: qual escolher →</a>
    ·
    <a href="/moedor-de-cafe/">moedor de café: qual escolher →</a>
  </p>

  <section class="faq">
    <h2>Perguntas frequentes</h2>
    {faq.map((item) => (
      <div class="faq-item">
        <h3>{item.pergunta}</h3>
        <p>{item.resposta}</p>
      </div>
    ))}
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <style>
    .atualizado { color: var(--cor-texto-suave); font-size: 0.9rem; }
    .cluster-link { font-weight: 600; margin: 2.5rem 0 0; line-height: 2; }
    .como-escolhemos {
      background: var(--cor-superficie);
      border: 1px solid var(--cor-borda);
      border-radius: 10px;
      padding: 1rem 1.25rem;
      margin: 1.5rem 0;
    }
    .como-escolhemos h2 { font-size: 1rem; margin: 0 0 0.4rem; }
    .como-escolhemos p { margin: 0; font-size: 0.9rem; color: var(--cor-texto-suave); }
    .comparativo { margin: 1.5rem 0 2.5rem; }
    .tabela-wrap { overflow-x: auto; }
    table { width: 100%; border-collapse: collapse; table-layout: fixed; font-size: 0.85rem; }
    th, td {
      text-align: left;
      padding: 0.6rem 0.5rem;
      border-bottom: 1px solid var(--cor-borda);
      white-space: normal;
      overflow-wrap: break-word;
    }
    th { color: var(--cor-texto-suave); font-weight: 600; font-size: 0.75rem; text-transform: uppercase; }
    th:nth-child(1), td:nth-child(1) { width: 40%; }
    th:nth-child(2), td:nth-child(2) { width: 22%; }
    th:nth-child(3), td:nth-child(3) { width: 20%; }
    th:nth-child(4), td:nth-child(4) { width: 18%; }
    .botao-tabela {
      display: inline-block;
      background: var(--cor-acento);
      color: #fff;
      text-decoration: none;
      padding: 0.3rem 0.55rem;
      border-radius: 999px;
      font-size: 0.76rem;
      white-space: nowrap;
    }
    .categoria { margin-bottom: 2.5rem; padding-top: 0.5rem; }
    .honestidade {
      margin: 2.5rem 0;
      padding: 1.5rem 1.75rem;
      background: var(--cor-superficie);
      border: 1px solid var(--cor-borda);
      border-left: 4px solid var(--cor-vale-saber);
      border-radius: 10px;
    }
    .honestidade h2 { margin: 0 0 0.75rem; font-size: 1.15rem; }
    .honestidade p { margin: 0; color: var(--cor-texto-suave); }
    .faq {
      margin-top: 2.5rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--cor-borda);
    }
    .faq-item { margin-bottom: 1.25rem; }
    .faq-item h3 { font-size: 1rem; margin: 0 0 0.35rem; }
    .faq-item p { margin: 0; color: var(--cor-texto-suave); }

    @media (max-width: 640px) {
      table, thead, tbody, th, td, tr { display: block; }
      thead { position: absolute; left: -9999px; }
      tr {
        border: 1px solid var(--cor-borda);
        border-radius: 10px;
        padding: 0.75rem 0.9rem;
        margin-bottom: 0.75rem;
        background: var(--cor-superficie);
      }
      td {
        border: none;
        padding: 0.35rem 0;
        white-space: normal;
        width: auto !important;
      }
      td[data-label="Preço"] { white-space: nowrap; }
      td[data-label]:not([data-label=""])::before {
        content: attr(data-label);
        display: block;
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        color: var(--cor-texto-suave);
        margin-bottom: 0.1rem;
      }
      td:last-child { padding-top: 0.6rem; }
    }
  </style>
</Layout>
