---
import Layout from '../../layouts/Layout.astro';
import ProdutoCard from '../../components/ProdutoCard.astro';
import dados from '../../data/produtos-espumador.json';

const categoria = dados.categorias.find((c) => c.id === 'espumador-leite');
const produtos = categoria.produtos;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Início", item: "https://cafe.dicasinteligentes.com/" },
    { "@type": "ListItem", position: 2, name: "Espumador de leite", item: "https://cafe.dicasinteligentes.com/espumador-leite/" },
  ],
};

const faq = [
  {
    pergunta: "Espumador portátil (mini mixer) faz o mesmo que um de bancada?",
    resposta: "Faz a espuma, mas não aquece o leite. Se você quer cappuccino ou latte com leite quente, precisa esquentar o leite separado (microondas ou fogão) antes de usar o mini mixer. O modelo de bancada resolve os dois passos numa etapa só.",
  },
  {
    pergunta: "Qualquer leite espuma bem?",
    resposta: "Não. Leite integral costuma espumar melhor que desnatado, porque a gordura ajuda a estabilizar a espuma. Leites vegetais variam bastante — aveia costuma espumar razoavelmente bem, outros menos.",
  },
  {
    pergunta: "Vale a pena o modelo mais caro entre os de bancada?",
    resposta: "A diferença de preço entre os 3 modelos de bancada desta lista é pequena (R$280 a R$337). A Cremeira tem a nota mais alta, mas o Oster e o Black+Decker têm mais avaliações acumuladas — nenhum se destaca tanto a ponto de ser óbvio, vale comparar o que tiver disponível no momento.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((item) => ({
    "@type": "Question",
    name: item.pergunta,
    acceptedAnswer: { "@type": "Answer", text: item.resposta },
  })),
};
---
<Layout
  title="Espumador de leite: qual escolher"
  description="Espumadores de leite pesquisados na Amazon, com preço, nota e o defeito real de cada um, comparando modelo de bancada e portátil, pra escolher sem chute."
  image="/images/produtos/cremeira-leite-eletrica-127v.png"
>
  <p><a href="/">← Início</a></p>
  <h1>Espumador de leite: qual escolher</h1>
  <p class="atualizado">Todos os produtos abaixo foram pesquisados na Amazon, com preço, nota e avaliações reais.</p>

  <p>
    Espumador errado é espuma que desmancha rápido ou aparelho que só bate,
    sem esquentar o leite de verdade. Nessa lista comparamos modelo de
    bancada (aquece e espuma) e modelo portátil (só espuma, bem mais
    barato).
  </p>

  <section class="como-escolhemos">
    <h2>Como escolhemos</h2>
    <p>
      Nenhum produto entra nessa lista sem um defeito real declarado (bloco
      "Vale saber" em cada card), pesquisado na ficha técnica e nas
      características reais do produto. Preço sempre em faixa, nunca fixo.
    </p>
  </section>

  <section class="comparativo">
    <h2>Comparativo rápido</h2>
    <div class="tabela-wrap">
      <table>
        <thead>
          <tr>
            <th>Produto</th>
            <th>Preço</th>
            <th>Selo</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          {produtos.map((produto) => (
            <tr>
              <td data-label="Produto">{produto.nome}</td>
              <td data-label="Preço">{produto.precoMin === produto.precoMax ? `R$ ${produto.precoMin}` : `R$ ${produto.precoMin} a R$ ${produto.precoMax}`}</td>
              <td data-label="Selo">{produto.selo || "—"}</td>
              <td data-label="">
                <a class="botao-tabela" href={produto.linkAmazon} rel="sponsored nofollow">Ver preço</a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="honestidade">
    <h2>Onde vale gastar mais, onde não faz diferença</h2>
    <p>
      O salto de R$25 (mini mixer) pra R$280+ (modelos de bancada) é sobre
      aquecer o leite automaticamente, não sobre qualidade da espuma em si
      — o mini mixer bem usado espuma bem, só exige o passo extra de
      esquentar o leite. Entre os 3 modelos de bancada, a diferença de
      preço é pequena e nenhum se destaca disparado — compare o que
      estiver disponível na hora da compra.
    </p>
  </section>

  <section id={categoria.id} class="categoria">
    <h2>{categoria.nome}</h2>
    <p>{categoria.descricao}</p>
    {produtos.map((produto) => <ProdutoCard produto={produto} />)}
  </section>

  <p class="cluster-link">
    Veja também:
    <a href="/espumador-leite/erros-comuns/">os erros mais comuns fazendo espuma de leite →</a>
    ·
    <a href="/espumador-leite/por-orcamento/">os mesmos espumadores por orçamento →</a>
    ·
    <a href="/espumador-leite/comparativo-top3/">comparativo Top 3 lado a lado →</a>
    ·
    <a href="/cafeteira/">cafeteira elétrica: qual escolher →</a>
    ·
    <a href="/prensa-francesa/">prensa francesa: qual escolher →</a>
    ·
    <a href="/chaleira-eletrica/">chaleira elétrica: qual escolher →</a>
  </p>

  <section class="faq">
    <h2>Perguntas frequentes</h2>
    {faq.map((item) => (
      <div class="faq-item">
        <h3>{item.pergunta}</h3>
        <p>{item.resposta}</p>
      </div>
    ))}
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <style>
    .atualizado { color: var(--cor-texto-suave); font-size: 0.9rem; }
    .cluster-link { font-weight: 600; margin: 2.5rem 0 0; line-height: 2; }
    .como-escolhemos {
      background: var(--cor-superficie);
      border: 1px solid var(--cor-borda);
      border-radius: 10px;
      padding: 1rem 1.25rem;
      margin: 1.5rem 0;
    }
    .como-escolhemos h2 { font-size: 1rem; margin: 0 0 0.4rem; }
    .como-escolhemos p { margin: 0; font-size: 0.9rem; color: var(--cor-texto-suave); }
    .comparativo { margin: 1.5rem 0 2.5rem; }
    .tabela-wrap { overflow-x: auto; }
    table { width: 100%; border-collapse: collapse; table-layout: fixed; font-size: 0.85rem; }
    th, td {
      text-align: left;
      padding: 0.6rem 0.5rem;
      border-bottom: 1px solid var(--cor-borda);
      white-space: normal;
      overflow-wrap: break-word;
    }
    th { color: var(--cor-texto-suave); font-weight: 600; font-size: 0.75rem; text-transform: uppercase; }
    th:nth-child(1), td:nth-child(1) { width: 40%; }
    th:nth-child(2), td:nth-child(2) { width: 22%; }
    th:nth-child(3), td:nth-child(3) { width: 20%; }
    th:nth-child(4), td:nth-child(4) { width: 18%; }
    .botao-tabela {
      display: inline-block;
      background: var(--cor-acento);
      color: #fff;
      text-decoration: none;
      padding: 0.3rem 0.55rem;
      border-radius: 999px;
      font-size: 0.76rem;
      white-space: nowrap;
    }
    .categoria { margin-bottom: 2.5rem; padding-top: 0.5rem; }
    .honestidade {
      margin: 2.5rem 0;
      padding: 1.5rem 1.75rem;
      background: var(--cor-superficie);
      border: 1px solid var(--cor-borda);
      border-left: 4px solid var(--cor-vale-saber);
      border-radius: 10px;
    }
    .honestidade h2 { margin: 0 0 0.75rem; font-size: 1.15rem; }
    .honestidade p { margin: 0; color: var(--cor-texto-suave); }
    .faq {
      margin-top: 2.5rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--cor-borda);
    }
    .faq-item { margin-bottom: 1.25rem; }
    .faq-item h3 { font-size: 1rem; margin: 0 0 0.35rem; }
    .faq-item p { margin: 0; color: var(--cor-texto-suave); }

    @media (max-width: 640px) {
      table, thead, tbody, th, td, tr { display: block; }
      thead { position: absolute; left: -9999px; }
      tr {
        border: 1px solid var(--cor-borda);
        border-radius: 10px;
        padding: 0.75rem 0.9rem;
        margin-bottom: 0.75rem;
        background: var(--cor-superficie);
      }
      td {
        border: none;
        padding: 0.35rem 0;
        white-space: normal;
        width: auto !important;
      }
      td[data-label="Preço"] { white-space: nowrap; }
      td[data-label]:not([data-label=""])::before {
        content: attr(data-label);
        display: block;
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        color: var(--cor-texto-suave);
        margin-bottom: 0.1rem;
      }
      td:last-child { padding-top: 0.6rem; }
    }
  </style>
</Layout>
